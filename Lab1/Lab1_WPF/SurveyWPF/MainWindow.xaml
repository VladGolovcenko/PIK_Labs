<Window x:Class="SurveyWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Опитування"
        Width="580" Height="460"
        MinWidth="580" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="#F5F4F1">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1E1E1E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3A3A3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1E1E1E"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="#C8C6C1"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ECEAE5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <Grid x:Name="SurveyPanel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="0"
                         Height="3"
                         Minimum="0"
                         Foreground="#1E1E1E"
                         Background="#DDDBD6"
                         BorderThickness="0"
                         Margin="0,0,0,8"/>

            <TextBlock x:Name="CounterLabel"
                       Grid.Row="1"
                       HorizontalAlignment="Right"
                       Foreground="#8C8780"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Margin="0,0,0,28"/>

            <TextBlock x:Name="QuestionLabelSmall"
                       Grid.Row="2"
                       Text="ПИТАННЯ"
                       Foreground="#8A7D6A"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       FontWeight="Medium"
                       Margin="0,0,0,10"/>

            <TextBlock x:Name="QuestionLabel"
                       Grid.Row="3"
                       FontFamily="Georgia"
                       FontSize="22"
                       Foreground="#141414"
                       TextWrapping="Wrap"
                       Margin="0,0,0,20"/>

            <TextBox x:Name="AnswerInput"
                     Grid.Row="4"
                     Background="#EBE9E4"
                     Foreground="#141414"
                     FontFamily="Segoe UI"
                     FontSize="13"
                     BorderThickness="0"
                     Padding="12"
                     TextWrapping="Wrap"
                     AcceptsReturn="False"
                     VerticalScrollBarVisibility="Auto"
                     KeyDown="AnswerInput_KeyDown"/>

            <Grid Grid.Row="5" Margin="0,20,0,0">
                <Button x:Name="NextButton"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}"
                        Click="NextButton_Click"/>
            </Grid>
        </Grid>

        <Grid x:Name="ResultPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Опитування завершено"
                       FontFamily="Georgia"
                       FontSize="24"
                       Foreground="#141414"
                       Margin="0,0,0,6"/>

            <TextBlock Grid.Row="1"
                       Text="Відповіді збережено у файл."
                       FontFamily="Segoe UI"
                       FontSize="11"
                       Foreground="#8C8780"
                       Margin="0,0,0,24"/>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ResultList"/>
            </ScrollViewer>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">
                <Button Content="Завантажити TXT"
                        Style="{StaticResource OutlineButton}"
                        Margin="0,0,8,0"
                        Click="DownloadButton_Click"/>
                <Button Content="Пройти знову"
                        Style="{StaticResource PrimaryButton}"
                        Click="RestartButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
